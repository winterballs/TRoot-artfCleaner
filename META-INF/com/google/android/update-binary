#!/sbin/sh
umask 022
OUTFD=$2
ZIPFILE=$3

ui_print() {
  echo "ui_print $1" >&$OUTFD
  echo "ui_print" >&$OUTFD
}

ui_print "- Temp Root Artifact Cleaner"
ui_print "- Deletes root artifacts left by CVE exploits"

MODDIR=/data/adb/modules/tmp_artifact_cleaner
rm -rf "$MODDIR"
mkdir -p "$MODDIR"
unzip -o "$ZIPFILE" "module.prop" "service.sh" -d "$MODDIR" >&2
chmod 755 "$MODDIR/service.sh"
chmod 644 "$MODDIR/module.prop"

ui_print "- Done!"
exit 0
